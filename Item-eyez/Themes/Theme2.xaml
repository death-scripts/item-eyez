<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and global backgrounds (Chrome-like dark theme) -->
    <!-- Dark neutral background similar to Chrome dark mode -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202124" />
    <!-- Slightly lighter thumb for contrast on dark track -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#FF3C4043" />

    <!-- GroupBox visuals -->
    <!-- Dark surfaces with subtle borders -->
    <SolidColorBrush x:Key="GroupBox.Static.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FF3C4043" />
    <SolidColorBrush x:Key="GroupBoxHeaderBorderBrush" Color="#FF5F6368" />
    <SolidColorBrush x:Key="GroupBoxHeaderForegroundBrush" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="GroupBoxOuterBorderBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="GroupBoxInnerBorderBrush" Color="#FF303134" />
    <SolidColorBrush x:Key="GroupBoxTransparentBorderBrush" Color="Transparent" />

    <!-- TextBox visuals -->
    <!-- Dark text boxes slightly lighter than the window (about 30% lighter than before) -->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#FF383A3E" />
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FF5F6368" />
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF8AB4F8" />

    <!-- WatermarkTextBox template brushes -->
    <SolidColorBrush x:Key="WatermarkBorderBrush" Color="#FF5F6368" />
    <SolidColorBrush x:Key="WatermarkFocusedBorderBrush" Color="#FF8AB4F8" />

    <!-- Main tab control -->
    <SolidColorBrush x:Key="MainTabControlBackgroundBrush" Color="#FF202124" />

    <!-- DataGrid backgrounds -->
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#FF292A2D" />
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FF202124" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FF292A2D" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FF303134" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#FF3C4043" />
    <SolidColorBrush x:Key="PathTextBrush" Color="#FF8AB4F8" />

    <!-- Organize view brushes -->
    <!-- Match drag node background to text box background -->
    <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#FF383A3E" />
    <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#FF202124" />
    <SolidColorBrush x:Key="OrganizeNodeBorderBrush" Color="#FF3C4043" />
    <SolidColorBrush x:Key="OrganizeNodeTextBackgroundBrush" Color="Transparent" />
    <!-- Light blue highlight similar to Chrome selection, over same base as text boxes -->
    <SolidColorBrush x:Key="OrganizeNodeHighlightBackgroundBrush" Color="#66383A3E" />
    <SolidColorBrush x:Key="OrganizeNodeDropTargetBorderBrush" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="OrganizeNodeTextForegroundBrush" Color="#FFE8EAED" />

    <!-- Button visuals -->
    <!-- Dark buttons with blue hover/press accents -->
    <SolidColorBrush x:Key="Button.Static.Background" Color="#FF303134" />
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FF3C4043" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FF1A73E8" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF5F6368" />

    <!-- ComboBox visuals -->
    <!-- ComboBox styling aligned with the dark theme -->
    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#FF5F6368" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="#FF5F6368" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="#FF303134" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="#FF5F6368" />

    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#FF3C4043" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" Color="#FF3C4043" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="#FF8AB4F8" />

    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="#FF1A73E8" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Background" Color="#FF1A73E8" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="#FF8AB4F8" />

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FF5F6368" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Border" Color="#FF3C4043" />

    <!-- TabItem visuals -->
    <!-- Off-white tab text and dark backgrounds -->
    <SolidColorBrush x:Key="TabItem.ForegroundBrush" Color="#FFECEFF1" />
    <SolidColorBrush x:Key="TabItem.Static.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#FF3C4043" />
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="#FF292A2D" />
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#FF3C4043" />

    <!-- Menu visuals -->
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#FF202124" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#FF3C4043" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FF3C4043" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF5F6368" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#FF3C4043" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#333C4043" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#333C4043" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#FF5F6368" />

    <!-- Override system text brushes for dark theme:
         light control/menu text, white selected text on blue highlight -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFB0B0B0" />

</ResourceDictionary>
