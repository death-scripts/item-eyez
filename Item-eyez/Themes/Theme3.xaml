<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and global backgrounds (blue/purple variant of Theme1) -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF5B4B8A" />
        <GradientStop Offset="1" Color="#FF4A90E2" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScrollBarThumbBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF7A6FD1" />
        <GradientStop Offset="1.0" Color="#FF4A90E2" />
    </LinearGradientBrush>

    <!-- GroupBox visuals -->
    <LinearGradientBrush x:Key="GroupBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="1.0" Color="#FF7C4DFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FF80DEEA" />
    <SolidColorBrush x:Key="GroupBoxHeaderBorderBrush" Color="#FF3F51B5" />
    <SolidColorBrush x:Key="GroupBoxHeaderForegroundBrush" Color="#FF3F51B5" />
    <SolidColorBrush x:Key="GroupBoxOuterBorderBrush" Color="Black" />
    <SolidColorBrush x:Key="GroupBoxInnerBorderBrush" Color="Black" />
    <SolidColorBrush x:Key="GroupBoxTransparentBorderBrush" Color="Transparent" />

    <!-- TextBox visuals -->
    <LinearGradientBrush x:Key="TextBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF4A90E2" />
        <GradientStop Offset="1.0" Color="#FF80DEEA" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FFB3CDE8" />
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF5C6BC0" />

    <!-- Button visuals -->
    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="1.0" Color="#FF80DEEA" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFB3E5FC" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF7E57C2" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FF283593" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF3949AB" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFBDBDBD" />
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383" />

    <!-- ComboBox visuals -->
    <LinearGradientBrush x:Key="ComboBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="1.0" Color="#FF80DEEA" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FF303030" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="#FF4A90E2" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent" />

    <LinearGradientBrush x:Key="ComboBox.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF5C6BC0" />
        <GradientStop Offset="1.0" Color="#FFB39DDB" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#FFCE93D8" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="#FF9FA8DA" />
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="1.0" Color="#FF7E57C2" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="#FF9FA8DA" />

    <LinearGradientBrush x:Key="ComboBox.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF283593" />
        <GradientStop Offset="1.0" Color="#FF5C6BC0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="#FF3949AB" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="#FF5C6BC0" />
    <LinearGradientBrush x:Key="ComboBox.Pressed.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF283593" />
        <GradientStop Offset="1.0" Color="#FF5C6BC0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="#FF5C6BC0" />

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="#FFBDBDBD" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FF9E9E9E" />

    <!-- ScrollBar colors -->
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#FFBDBDBD" />

    <!-- Menu visuals (blue/purple variant of Theme1) -->
    <LinearGradientBrush x:Key="Menu.Static.Background">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="0.6" Color="#FFBBDEFB" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FF212121" />
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FFB0BEC5" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF757575" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#FF5C6BC0" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#FF7E57C2" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#FF7E57C2" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#403F51B5" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#609FA8DA" />

    <!-- WatermarkTextBox template brushes -->
    <SolidColorBrush x:Key="WatermarkBorderBrush" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="WatermarkFocusedBorderBrush" Color="#FF3F51B5" />

    <!-- Main tab control -->
    <SolidColorBrush x:Key="MainTabControlBackgroundBrush" Color="#FFE3F2FD" />

    <!-- DataGrid backgrounds -->
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#FFE8EAF6" />
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFE3F2FD" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFBBDEFB" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FF3F51B5" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#FF9FA8DA" />
    <SolidColorBrush x:Key="PathTextBrush" Color="#FF3F51B5" />

    <!-- Organize view brushes -->
    <LinearGradientBrush x:Key="NodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF5C6BC0" />
        <GradientStop Offset="1" Color="#FF80DEEA" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TreeBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3F51B5" />
        <GradientStop Offset="1" Color="#FFB39DDB" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OrganizeNodeBorderBrush" Color="#FF3F51B5" />
    <SolidColorBrush x:Key="OrganizeNodeTextBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrganizeNodeHighlightBackgroundBrush" Color="#FFEDE7F6" />
    <SolidColorBrush x:Key="OrganizeNodeDropTargetBorderBrush" Color="#FFAB47BC" />
    <SolidColorBrush x:Key="OrganizeNodeTextForegroundBrush" Color="#FF000000" />

    <!-- TabItem visuals -->
    <LinearGradientBrush x:Key="TabItem.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF3F51B5" />
        <GradientStop Offset="0.6" Color="#FFBBDEFB" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#FFB0BEC5" />
    <LinearGradientBrush x:Key="TabItem.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FFBBDEFB" />
        <GradientStop Offset="0.6" Color="#FF3F51B5" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#FF9FA8DA" />
    <LinearGradientBrush x:Key="TabItem.Selected.Background">
        <GradientStop Offset="0.0" Color="#FF5C6BC0" />
        <GradientStop Offset="1.0" Color="#FFB39DDB" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#FF7E57C2" />
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#FFB0BEC5" />

</ResourceDictionary>
