<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and global backgrounds -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="HotPink" />
        <GradientStop Offset="1" Color="MediumAquamarine" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScrollBarThumbBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="LightGreen" />
        <GradientStop Offset="1.0" Color="MediumAquamarine" />
    </LinearGradientBrush>

    <!-- GroupBox visuals -->
    <LinearGradientBrush x:Key="GroupBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="Red" />
        <GradientStop Offset="1.0" Color="Orange" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="Cyan" />
    <SolidColorBrush x:Key="GroupBoxHeaderBorderBrush" Color="Blue" />
    <SolidColorBrush x:Key="GroupBoxOuterBorderBrush" Color="Black" />
    <SolidColorBrush x:Key="GroupBoxInnerBorderBrush" Color="Black" />
    <SolidColorBrush x:Key="GroupBoxTransparentBorderBrush" Color="Transparent" />

    <!-- TextBox visuals -->
    <LinearGradientBrush x:Key="TextBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="MediumAquamarine" />
        <GradientStop Offset="1.0" Color="Cyan" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FFABAdB3" />
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF7EB4EA" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF569DE5" />

    <!-- Button visuals -->
    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#db4437" />
        <GradientStop Offset="1.0" Color="Cyan" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="HotPink" />
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="LightCyan" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="Coral" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#db4437" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="DarkCyan" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5" />
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383" />

    <!-- ComboBox visuals -->
    <LinearGradientBrush x:Key="ComboBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#db4437" />
        <GradientStop Offset="1.0" Color="Cyan" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="HotPink" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FF606060" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="Cyan" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="HotPink" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent" />

    <LinearGradientBrush x:Key="ComboBox.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="DarkRed" />
        <GradientStop Offset="1.0" Color="LightCoral" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="Pink" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="HotPink" />
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="Red" />
        <GradientStop Offset="1.0" Color="Coral" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="#FF7EB4EA" />

    <LinearGradientBrush x:Key="ComboBox.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="LightBlue" />
        <GradientStop Offset="1.0" Color="HotPink" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="HotPink" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="#FF569DE5" />
    <LinearGradientBrush x:Key="ComboBox.Pressed.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="DarkBlue" />
        <GradientStop Offset="1.0" Color="DarkCyan" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="HotPink" />

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="HotPink" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FFBFBFBF" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Border" Color="HotPink" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Background" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Border" Color="HotPink" />

    <!-- Menu visuals -->
    <LinearGradientBrush x:Key="Menu.Static.Background">
        <GradientStop Offset="0.0" Color="#db4437" />
        <GradientStop Offset="0.6" Color="LightBlue" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Menu.Static.Border" Color="HotPink" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FF212121" />
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FFD7D7D7" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF707070" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="Coral" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#FF26A0DA" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="Red" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#FF26A0DA" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#0A000000" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#21000000" />

    <!-- WatermarkTextBox template brushes -->
    <SolidColorBrush x:Key="WatermarkBorderBrush" Color="Gray" />
    <SolidColorBrush x:Key="WatermarkFocusedBorderBrush" Color="Blue" />

    <!-- Main tab control -->
    <SolidColorBrush x:Key="MainTabControlBackgroundBrush" Color="Beige" />

    <!-- DataGrid backgrounds used in multiple views -->
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="LightBlue" />
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="Pink" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="SkyBlue" />

    <!-- Organize view brushes -->
    <LinearGradientBrush x:Key="NodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF8ECD" />
        <GradientStop Offset="1" Color="#78F0E2" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TreeBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#20B2AA" />
        <GradientStop Offset="1" Color="#FFDAB9" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OrganizeNodeBorderBrush" Color="Blue" />
    <SolidColorBrush x:Key="OrganizeNodeTextBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrganizeNodeHighlightBackgroundBrush" Color="LightGoldenrodYellow" />
    <SolidColorBrush x:Key="OrganizeNodeDropTargetBorderBrush" Color="Lime" />

</ResourceDictionary>
