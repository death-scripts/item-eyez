<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and global backgrounds (dark teal/orange theme) -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0F2027" />
        <GradientStop Offset="1" Color="#FF203A43" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScrollBarThumbBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF2C5364" />
        <GradientStop Offset="1.0" Color="#FF18A999" />
    </LinearGradientBrush>

    <!-- GroupBox visuals -->
    <LinearGradientBrush x:Key="GroupBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF0F2027" />
        <GradientStop Offset="1.0" Color="#FF2C5364" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="GroupBoxHeaderBorderBrush" Color="#FFFF8F00" />
    <SolidColorBrush x:Key="GroupBoxHeaderForegroundBrush" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="GroupBoxOuterBorderBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="GroupBoxInnerBorderBrush" Color="#FF424242" />
    <SolidColorBrush x:Key="GroupBoxTransparentBorderBrush" Color="Transparent" />

    <!-- TextBox visuals -->
    <LinearGradientBrush x:Key="TextBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF102A43" />
        <GradientStop Offset="1.0" Color="#FF16324F" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FF546E7A" />
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF90A4AE" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FFFFB74D" />

    <!-- Button visuals -->
    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF18A999" />
        <GradientStop Offset="1.0" Color="#FFFFB74D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FFFFA000" />
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFFFCC80" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FF00897B" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FFFF8F00" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FF37474F" />
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FF455A64" />
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FFB0BEC5" />

    <!-- ComboBox visuals -->
    <LinearGradientBrush x:Key="ComboBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF102A43" />
        <GradientStop Offset="1.0" Color="#FF18A999" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#FF546E7A" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="#FF102A43" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="#FF546E7A" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent" />

    <LinearGradientBrush x:Key="ComboBox.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF18A999" />
        <GradientStop Offset="1.0" Color="#FFFFB74D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#FFFFCC80" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="#FF16324F" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="#FFFFB74D" />
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF18A999" />
        <GradientStop Offset="1.0" Color="#FFFFB74D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="#FFFFCC80" />

    <LinearGradientBrush x:Key="ComboBox.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF00897B" />
        <GradientStop Offset="1.0" Color="#FFFF8F00" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="#FF102A43" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="#FFFFA000" />
    <LinearGradientBrush x:Key="ComboBox.Pressed.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF00897B" />
        <GradientStop Offset="1.0" Color="#FFFF8F00" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="#FFFFA000" />

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#FF37474F" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="#FF455A64" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FFB0BEC5" />

    <!-- ScrollBar colors -->
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#FF263238" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#FF37474F" />

    <!-- Menu visuals -->
    <LinearGradientBrush x:Key="Menu.Static.Background">
        <GradientStop Offset="0.0" Color="#FF102A43" />
        <GradientStop Offset="0.6" Color="#FF16324F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#FF546E7A" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FF455A64" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF78909C" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#FF18A999" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#FF263238" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#FFFFCC80" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#40263238" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#60455A64" />

    <!-- WatermarkTextBox template brushes -->
    <SolidColorBrush x:Key="WatermarkBorderBrush" Color="#FF546E7A" />
    <SolidColorBrush x:Key="WatermarkFocusedBorderBrush" Color="#FFFFA000" />

    <!-- Main tab control -->
    <SolidColorBrush x:Key="MainTabControlBackgroundBrush" Color="#FF102A43" />

    <!-- DataGrid backgrounds -->
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#FF16324F" />
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FF102A43" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FF1C3A57" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FF263238" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFF3E0" />
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="PathTextBrush" Color="#FFFFB74D" />

    <!-- Organize view brushes -->
    <LinearGradientBrush x:Key="NodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF18A999" />
        <GradientStop Offset="1" Color="#FFFFB74D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TreeBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0F2027" />
        <GradientStop Offset="1" Color="#FF203A43" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OrganizeNodeBorderBrush" Color="#FFFFA000" />
    <SolidColorBrush x:Key="OrganizeNodeTextBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrganizeNodeHighlightBackgroundBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="OrganizeNodeDropTargetBorderBrush" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="OrganizeNodeTextForegroundBrush" Color="#FF000000" />

    <!-- TabItem visuals -->
    <LinearGradientBrush x:Key="TabItem.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF102A43" />
        <GradientStop Offset="0.6" Color="#FF18A999" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#FF546E7A" />
    <LinearGradientBrush x:Key="TabItem.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF18A999" />
        <GradientStop Offset="0.6" Color="#FFFFB74D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#FFFFCC80" />
    <LinearGradientBrush x:Key="TabItem.Selected.Background">
        <GradientStop Offset="0.0" Color="#FFFFB74D" />
        <GradientStop Offset="1.0" Color="#FF18A999" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#FFFFA000" />
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FF37474F" />
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#FF455A64" />

    <!-- Override system text brushes for dark theme -->
    <!-- Use orange for general control text to improve contrast on dark backgrounds -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFB0BEC5" />

</ResourceDictionary>
